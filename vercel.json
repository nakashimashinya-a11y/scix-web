{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "redirects": [
    { "source": "/bss", "destination": "/transfer", "permanent": true },
    { "source": "/en/bss", "destination": "/en/transfer", "permanent": true },
    { "source": "/sell", "destination": "/sourcing", "permanent": true },
    { "source": "/en/sell", "destination": "/en/sourcing", "permanent": true }
  ],
  "rewrites": [
    { "source": "/お問い合わせ", "destination": "/contact.html" },
    { "source": "/会社案内", "destination": "/company.html" },
    { "source": "/ナレッジ", "destination": "/knowledge.html" },
    { "source": "/蓄電池用地の査定", "destination": "/sourcing.html" },
    { "source": "/蓄電池用地査定依頼", "destination": "/sell-form.html" },
    { "source": "/系統蓄電池事業", "destination": "/transfer.html" }
  ]
}
