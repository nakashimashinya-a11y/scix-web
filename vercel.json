{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/header.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "invest.scix.co.jp" }], "destination": "/fund" }
  ],
  "redirects": [
    { "source": "/bss", "destination": "/transfer", "permanent": true },
    { "source": "/sell", "destination": "/sourcing", "permanent": true },
    { "source": "/en/bss", "destination": "/en", "permanent": true },
    { "source": "/en/sell", "destination": "/en", "permanent": true },
    { "source": "/en/investors", "destination": "/en", "permanent": true },
    { "source": "/en/transfer", "destination": "/en", "permanent": true },
    { "source": "/en/sourcing", "destination": "/en", "permanent": true },
    { "source": "/en/land", "destination": "/en", "permanent": true },
    { "source": "/en/company", "destination": "/en", "permanent": true },
    { "source": "/en/market-entry", "destination": "/en", "permanent": true },

    { "source": "/会社案内", "destination": "/company", "permanent": true },
    { "source": "/%E4%BC%9A%E7%A4%BE%E6%A1%88%E5%86%85", "destination": "/company", "permanent": true },
    { "source": "/お問い合わせ", "destination": "/contact", "permanent": true },
    { "source": "/%E3%81%8A%E5%95%8F%E3%81%84%E5%90%88%E3%82%8F%E3%81%9B", "destination": "/contact", "permanent": true },
    { "source": "/ナレッジ", "destination": "/knowledge", "permanent": true },
    { "source": "/%E3%83%8A%E3%83%AC%E3%83%83%E3%82%B8", "destination": "/knowledge", "permanent": true },
    { "source": "/蓄電池用地の査定", "destination": "/sourcing", "permanent": true },
    { "source": "/%E8%93%84%E9%9B%BB%E6%B1%A0%E7%94%A8%E5%9C%B0%E3%81%AE%E6%9F%BB%E5%AE%9A", "destination": "/sourcing", "permanent": true },
    { "source": "/蓄電池用地査定依頼", "destination": "/sell-form", "permanent": true },
    { "source": "/%E8%93%84%E9%9B%BB%E6%B1%A0%E7%94%A8%E5%9C%B0%E6%9F%BB%E5%AE%9A%E4%BE%9D%E9%A0%BC", "destination": "/sell-form", "permanent": true },
    { "source": "/系統蓄電池事業", "destination": "/transfer", "permanent": true },
    { "source": "/%E7%B3%BB%E7%B5%B1%E8%93%84%E9%9B%BB%E6%B1%A0%E4%BA%8B%E6%A5%AD", "destination": "/transfer", "permanent": true },

    { "source": "/feed", "destination": "/knowledge", "permanent": true },
    { "source": "/feed.xml", "destination": "/knowledge", "permanent": true },
    { "source": "/feeds/all.atom.xml", "destination": "/knowledge", "permanent": true },
    { "source": "/10", "destination": "/knowledge", "permanent": true }
  ]
}
